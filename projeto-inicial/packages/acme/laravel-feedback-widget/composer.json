{
    "name": "acme/laravel-feedback-widget",
    "description": "Widget de feedback reutilizável para aplicações Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Acme\\FeedbackWidget\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Acme\\FeedbackWidget\\FeedbackWidgetServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
